# Supabase — copy to .env and fill in.
# Anon (publishable) key only — the service_role key never goes in client code.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Optional: gate magic-link sign-up behind a shared invite code.
# When set, visitors must enter this code to request a magic link.
# When unset, magic-link sign-up is open. Rotate by changing the value
# and redeploying. Existing accounts are unaffected by rotation.
# VITE_DEMO_INVITE_CODE="koudou-2026"
